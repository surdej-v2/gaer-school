# ~/gaer/app.env on the server — the app's settings. Never commit the real file.
# Database URLs, GAER_ENV and TRUST_PROXY are set by compose.yml.

DOMAIN=app.kunde.dk
ORIGIN=https://app.kunde.dk
RP_ID=app.kunde.dk
RP_NAME=Kunde
# openssl rand -hex 32
SECRET_KEY=
# Authenticator-app secrets are encrypted with these keys, so SECRET_KEY can be rotated on its own.
# "<version>:<base64 of 32 bytes>", newest first; keep old versions until no factor uses them.
# echo "1:$(openssl rand -base64 32)"
TOTP_KEYS=
# Webhook signing secrets and auth headers are encrypted with these keys (same format as TOTP_KEYS).
SECRET_BOX_KEYS=

# Robot check (proof of work, no third party) in front of login and sign-up with a code. "off" removes it.
# CAPTCHA=pow
# CAPTCHA_MAX_NUMBER=50000

# Background jobs run in the app container: JOB_WORKERS workers, retries with backoff, schedules in /admin/jobs.
# JOB_WORKERS=2

# MFA: /admin needs a passkey, security key or authenticator app after GRACE_LOGINS logins with a code.
# Defaults: GRACE_LOGINS=3, ADMIN_MFA_HOURS=12 (how long a second factor opens /admin),
# STEPUP_MINUTES=15 (security actions in /admin), MFA_SESSION_MINUTES=15 (pending second-factor login).

# Recommended in production: the only e-mail address that may become the first admin (super admin).
# Without it, whoever logs in first on a new instance becomes admin.
BOOTSTRAP_ADMIN_EMAIL=

# Front page /w/ until an admin chooses in /admin/web: markdown (default) or facit246 (the 246 story).
WEB_FRONT=markdown

# Login codes go by e-mail — without these, nobody can log in. MAIL_PROVIDER: ahasend, scaleway, mailjet, brevo or
# lettermint (see server/app/mail.py for each provider's variables). MAIL_FROM must be on a verified domain.
MAIL_PROVIDER=lettermint
MAIL_FROM=login@app.kunde.dk
MAIL_FROM_NAME=Kunde
LETTERMINT_API_TOKEN=

# Optional: also log in with a phone number and a code by SMS (OVHcloud).
SMS_LOGIN=0
SMS_PROVIDER=ovh
SMS_SENDER=Kunde
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE=sms-xx00000-1

# Object Storage (S3-compatible), e.g. UpCloud Managed Object Storage or OVHcloud Object Storage
STORAGE_BACKEND=s3
S3_ENDPOINT=https://xxxxx.upcloudobjects.com
S3_REGION=europe-4
S3_BUCKET=gaer-kunde
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional AI chat — OVHcloud AI Endpoints (OpenAI-compatible, processed in Europe). Empty key = chat off.
AI_API_KEY=
AI_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
AI_MODEL=Meta-Llama-3_3-70B-Instruct

# MCP servers: /mcp (the app, as the logged-in user) and /mcp/admin (admin, changes as drafts). 0 turns one off.
# MCP_DB_QUERY_URL (db_query, read only) is set by compose.yml.
MCP_APP_ENABLED=1
MCP_ADMIN_ENABLED=1
MCP_DRAFT_TTL_MIN=10
MCP_ACCESS_TOKEN_MINUTES=60
MCP_REFRESH_TOKEN_DAYS=30

# NATS: NATS_URL and NATS_MONITOR_URL (for /admin/nats) are set by compose.yml.

# Optional GitHub classes on /class — a GitHub App the teachers install on their organisation.
# Setup: specs/classroom/README.md. Leave empty to keep /class in "not set up" mode.
# The private key goes on ONE line with \n between the PEM lines (docker --env-file cannot hold newlines).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
