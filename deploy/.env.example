# ~/gaer/.env on the server — the stack's secrets, read by docker compose (compose.yml). Never commit the real file.
# The app's own settings are in app.env (see app.env.example).

# The instance's database in the stack's own Postgres. postgres-init.sh creates it and the roles
# <db>_owner (migrations), <db>_app (the app), <db>_purge (deletes log data) and <db>_mcp_ro (db_query in /mcp/admin)
# the first time the volume is empty. openssl rand -hex 24 for each password.
DB_NAME=gaer_kunde
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_PURGE_PASSWORD=
DB_MCP_RO_PASSWORD=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels); the public hostname points at http://app:8000.
TUNNEL_TOKEN=

# NATS (JetStream on the "nats" volume). Clients use this token; empty = no auth (only containers in the stack can
# reach NATS either way). openssl rand -hex 24 — hex only, it goes into NATS_URL.
NATS_TOKEN=
