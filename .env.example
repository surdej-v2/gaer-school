# Copy to .env for local development. On the instance, deploy/.env.example is the template.

GAER_ENV=development
SECRET_KEY=dev-secret-change-me
# Optional: keys for authenticator-app secrets ("1:<base64 32 bytes>"). Unset: derived from SECRET_KEY.
TOTP_KEYS=
# Optional: keys for webhook secrets and auth headers, same format. Unset: derived from SECRET_KEY.
SECRET_BOX_KEYS=
# Robot check on login/sign-up with a code: pow (default) or off.
# CAPTCHA=pow
# Webhooks to http:// and localhost while developing:
WEBHOOK_ALLOW_PRIVATE=1
# Background jobs (retention, cleanup, webhook deliveries). RUN_MAINTENANCE=0 stops the worker.
# JOB_WORKERS=2

# Local Postgres from docker-compose. One user does everything in development.
DATABASE_URL=postgresql://gaer:gaer@localhost:5432/gaer
# PURGE_DATABASE_URL=
# MIGRATION_DATABASE_URL=

# Vite runs on :5173 and proxies /api to the Python server on :8000
ORIGIN=http://localhost:5173
RP_ID=localhost
RP_NAME=Gær

# Login codes go by e-mail. MAIL_PROVIDER: ahasend (default), scaleway, mailjet, brevo, lettermint or console.
# console prints the mail in the server log and shows the code on the login page (development only).
MAIL_PROVIDER=console
MAIL_FROM=
MAIL_FROM_NAME=
# AhaSend: API key (scope messages:send:<domain>) and account id
AHASEND_API_KEY=
AHASEND_ACCOUNT_ID=
# Scaleway Transactional Email
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_REGION=fr-par
# Mailjet
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Brevo
BREVO_API_KEY=
# Lettermint (Project API token)
LETTERMINT_API_TOKEN=

# Opt-in: also allow login with a phone number and a code by SMS.
SMS_LOGIN=0
# Demo: codes are written to the server log instead of being sent (also in production). Only for trying an
# instance before mail is set up: whoever can read the server log can log in.
DEMO_MODE=0
# SMS: console prints the code in the server log and shows it on the login page
SMS_PROVIDER=console
SMS_SENDER=Gaer

# MinIO from docker-compose
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=gra
S3_BUCKET=gaer
S3_ACCESS_KEY=gaer
S3_SECRET_KEY=gaer-dev-secret

# Optional AI chat — OVHcloud AI Endpoints (OpenAI-compatible, processed in Europe).
# Leave AI_API_KEY empty to keep the chat off. Key: OVHcloud Manager → Public Cloud → AI Endpoints.
AI_API_KEY=
AI_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
AI_MODEL=Meta-Llama-3_3-70B-Instruct

# MCP servers in the container: /mcp (the app, as the logged-in user) and /mcp/admin (admin, changes as drafts).
# Clients log in with the normal Gær login (OAuth 2.0 PKCE). Set to 0 to turn a server off.
MCP_APP_ENABLED=1
MCP_ADMIN_ENABLED=1
MCP_DRAFT_TTL_MIN=10
MCP_ACCESS_TOKEN_MINUTES=60
MCP_REFRESH_TOKEN_DAYS=30
# db_query in /mcp/admin uses the read-only <db>_mcp_ro user (in production compose.yml sets it from DB_MCP_RO_PASSWORD).
# Leave empty to keep db_query off.
MCP_DB_QUERY_URL=

# Recommended in production: the only e-mail address that may become the first admin (super admin).
# Without it, whoever registers first on a new instance becomes super admin.
BOOTSTRAP_ADMIN_EMAIL=

# Front page /w/ until an admin chooses in /admin/web: markdown (default) or facit246 (the 246 story).
WEB_FRONT=markdown
# With SMS_LOGIN=1 a phone number can be the bootstrap admin instead.
BOOTSTRAP_ADMIN_PHONE=
